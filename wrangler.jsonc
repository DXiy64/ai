{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "ai",
	"account_id": "0f9c07148681eb05f3aec99ea1a15f72",
	"compatibility_date": "2026-10-15",
	"workers_dev": false,
	"preview_urls": false,
	"assets": {
		"directory": "./.output/public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		]
	},
	"routes": [
		{
			"pattern": "ai.mou7s.com",
			"custom_domain": true
		}
	],
	"main": "worker/index.mjs",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"kv_namespaces": [
		{
			"binding": "MODEL_DATA",
			"id": "28992e8d6bf34e4598e02b684a5cbe6b"
		}
	],
	"triggers": {
		"crons": [
			"0 */6 * * *"
		]
	},
	"observability": {
		"enabled": true
	}
}