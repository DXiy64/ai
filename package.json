{
  "name": "ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "refresh-data": "node --use-env-proxy scripts/refresh-data.mjs",
    "check": "node scripts/check-data.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/catalog.test.mjs tests/source.test.mjs",
    "test:ui": "node tests/preferences-zoom.cjs && node tests/catalog-ui.cjs",
    "format": "prettier --write src scripts tests index.html README.md .github package.json"
  },
  "engines": {
    "node": ">=24.5.0"
  },
  "dependencies": {
    "plotly.js-gl3d-dist-min": "^3.3.0"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "vite": "^7.1.0",
    "wrangler": "^4.151.0"
  }
}
