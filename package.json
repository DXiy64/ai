{
  "name": "ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun nuxt dev --host 127.0.0.1",
    "build": "bun --bun nuxt generate",
    "preview": "bun --bun nuxt preview",
    "deploy": "bun run build && wrangler deploy",
    "refresh-data": "bun scripts/refresh-data.mjs",
    "check": "bun scripts/check-data.mjs",
    "postinstall": "bun --bun nuxt prepare"
  },
  "engines": {
    "node": ">=24.5.0"
  },
  "dependencies": {
    "plotly.js-gl3d-dist-min": "^3.3.0",
    "nuxt": "^4.4.8",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "wrangler": "^4.151.0"
  },
  "packageManager": "bun@1.4.3"
}
